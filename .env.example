# Copy to .env (local dev) or /etc/selvedge-push.env (production, chmod 0600).
# Generate a fresh VAPID keypair with:
#   selvedge-push --generate-vapid-keys

# --- Required ---
VAPID_PRIVATE_KEY=replace-with-output-from-generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
APP_BASE_URL=https://selvedge.example.com

# --- Optional (uncomment to override defaults) ---
# ALLOWED_APP_ID=org.selvedge.web
# BIND_ADDR=127.0.0.1:8085
# CORS_ALLOWED_ORIGIN=https://selvedge.example.com
# HEARTBEAT_TTL_SECS=90
# MAX_HEARTBEATS=10000
# PUSH_TTL_SECS=86400
# OUTBOUND_TIMEOUT_SECS=5
# MAX_CONCURRENT_PUSHES=64
# RUST_LOG=selvedge_push=info,tower_http=info
